{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Document",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "documents"
    },
    "isRevised": {
      "type": "boolean"
    },
    "documentFile": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "comments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::comment.comment",
      "mappedBy": "documents"
    },
    "notifications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::notification.notification",
      "inversedBy": "documents"
    },
    "version": {
      "type": "integer"
    },
    "isCurrent": {
      "type": "boolean"
    },
    "previous_version": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::document.document",
      "inversedBy": "next_version"
    },
    "next_version": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::document.document",
      "inversedBy": "previous_version"
    },
    "restoredFrom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::document.document"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Subido",
        "En Revisión",
        "Aprobado",
        "Cambios Solicitados",
        "Archivado"
      ],
      "default": "Subido",
      "required": true
    }
  }
}
