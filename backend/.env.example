HOST=0.0.0.0
PORT=1337

# Genera cada valor con: openssl rand -base64 32
# APP_KEYS admite varias claves separadas por coma.
APP_KEYS="<genera-una-clave>,<genera-otra-clave>"
API_TOKEN_SALT=<genera-un-valor>
ADMIN_JWT_SECRET=<genera-un-valor>
TRANSFER_TOKEN_SALT=<genera-un-valor>
JWT_SECRET=<genera-un-valor>

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Credenciales del remitente de correo. Nunca las subas al repositorio.
SMTP_USER=<correo-remitente>
SMTP_PASS=<app-password>
